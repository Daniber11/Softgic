# =============================================================================
#  Plataforma de Gestión de Solicitudes Operacionales — variables de entorno
# =============================================================================
#  TODOS LOS VALORES DE ESTE ARCHIVO SON FICTICIOS Y DE USO EXCLUSIVAMENTE LOCAL.
#  No corresponden a ningún sistema real, ni del cliente ni de terceros.
#  Uso:  cp .env.example .env      (el archivo .env está en .gitignore)
# =============================================================================

# --- SQL Server 2022 ---------------------------------------------------------
# La contraseña debe cumplir la política de complejidad de SQL Server:
# 8+ caracteres con mayúscula, minúscula, dígito y símbolo.
SQLSERVER_SA_PASSWORD=Local#Demo2026
SQLSERVER_PORT=1433
SQLSERVER_DB_OPERACIONAL=solicitudes_db
SQLSERVER_DB_ANALITICA=indicadores_db

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=solicitudes_local
RABBITMQ_PASSWORD=Local#Rabbit2026
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Keycloak 26 -------------------------------------------------------------
# Credenciales del administrador de arranque. Local y ficticias.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=Local#Keycloak2026
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=solicitudes-gov

# --- Contraseña común de los cinco usuarios de prueba ------------------------
# Ficticia, documentada en el README y visible a propósito: es una credencial de
# demostración local, no un secreto. Ningún usuario real la utiliza.
USUARIOS_DEMO_PASSWORD=Demo#2026

# --- Servicios de aplicación -------------------------------------------------
SOLICITUDES_SERVICE_PORT=8081
INDICADORES_SERVICE_PORT=8082
SHELL_PORT=3000
MFE_INDICADORES_PORT=3001

# --- CORS --------------------------------------------------------------------
# Lista explícita de orígenes permitidos. Nunca "*" cuando se envían credenciales.
CORS_ORIGENES_PERMITIDOS=http://localhost:3000,http://localhost:3001

# --- Presupuesto de memoria (anfitrión con 8 GB para Docker) -----------------
JVM_MAX_RAM_PERCENTAGE=60
