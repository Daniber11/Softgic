    dependencias queda explicito en un unico archivo y se puede leer.
  -->

  <parent>
    <groupId>co.gov.solicitudes</groupId>
    <artifactId>solicitudes-service</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>application</artifactId>
  <name>Aplicacion</name>

  <dependencies>
    <dependency>
      <groupId>co.gov.solicitudes</groupId>
      <artifactId>domain</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
